          "remaining": {
            "name": "Remaining"
          }
        }
      },
      "finishes_at": {
        "name": "Finishes at"
      }
    },
    "event": {
      "cycle": {
        "name": "Cycle",
        "state_attributes": {
          "event_type": {
            "state": {
              "started": "Started",
              "paused": "Paused",
              "resumed": "Resumed",
              "cancelled": "Cancelled",
              "finished": "Finished",
              "emptied": "Emptied"
            }
          }
        }
      }
