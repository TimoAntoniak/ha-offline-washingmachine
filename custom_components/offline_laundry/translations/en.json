        },
        "load": {
          "name": "Load",
          "description": "Optional name, e.g. Colors 40°."
        }
      }
    },
    "pause": {
      "name": "Pause",
      "description": "Pauses the running load."
    },
    "resume": {
      "name": "Resume",
      "description": "Resumes the paused load."
    },
    "cancel": {
      "name": "Cancel",
      "description": "Cancels the running or paused load."
    },
    "empty": {
      "name": "Emptied",
      "description": "Marks the appliance as emptied."
    }
  },
  "exceptions": {
    "not_idle": {
      "message": "{name} is not ready. Empty or cancel it first."
    },
    "not_running": {
      "message": "{name} is not running."
    },
    "not_paused": {
      "message": "{name} is not paused."
    },
    "not_active": {
      "message": "{name} has no active load."
    },
    "not_finished": {
      "message": "{name} is not finished yet."
    },
    "invalid_duration": {
      "message": "The duration must be greater than 0."
    }
  }
